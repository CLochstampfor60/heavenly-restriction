{
  "name": "heavenly-restriction-frontend",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan-demo": "vite --host --mode demo",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "vite build --outDir dist-test && node --test \"tests/e2e/*.e2e.mjs\" && node scripts/browser.mjs",
    "screenshots": "vite build --outDir dist-test && node scripts/screenshots.mjs && node scripts/browser.mjs",
    "icons": "node scripts/icons.mjs",
    "browsers:check": "node scripts/browser.mjs",
    "browsers:clean": "node scripts/browser.mjs --kill"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "playwright-core": "1.65.1",
    "svelte": "5.57.3",
    "vite": "8.3.8"
  },
  "dependencies": {
    "dexie": "4.4.7"
  }
}
