# Copy to .env and fill in real values. .env is gitignored; never commit it.

# App
APP_ENV=development
APP_BASE_URL=https://app.example.ts.net

# Security: generate with  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
SESSION_DAYS=30

# Passkeys (WebAuthn): must match the hostname the phone uses
WEBAUTHN_RP_ID=app.example.ts.net
WEBAUTHN_RP_NAME=Heavenly Restriction

# Storage (paths inside the container; both are gitignored on the host)
DATABASE_URL=sqlite:////app/data/hr.db
MEDIA_DIR=/app/media

# Your program spreadsheet. Keep it OUTSIDE this repo; it is read, never copied in.
# Local run: a full Windows path. In Docker Compose: the host path to mount (see compose.yaml).
PROGRAM_XLSX_PATH=C:/path/outside/the/repo/Workout_Program.xlsx
