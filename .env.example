# Copy to .env and fill in real values. .env is gitignored; never commit it.

# App
APP_ENV=development
APP_BASE_URL=https://app.example.ts.net

# Sign-in (passkeys + server-side sessions; no signing secret needed)
# WEBAUTHN_RP_ID must match the hostname the phone uses; passkeys are bound to it, so keep it
# stable. For local development leave it as localhost and open http://localhost:8000.
WEBAUTHN_RP_ID=app.example.ts.net
WEBAUTHN_RP_NAME=Heavenly Restriction
# Origins allowed to sign in and to make changes. Optional: defaults to https://<WEBAUTHN_RP_ID>,
# or the local server and Vite dev server when the RP ID is localhost.
# APP_ORIGINS=https://app.example.ts.net
# Session lifetime and idle timeout.
SESSION_DAYS=30
SESSION_IDLE_HOURS=168
# Secure cookies. Keep 1; browsers accept them on http://localhost too.
COOKIE_SECURE=1

# Storage (paths inside the container; both are gitignored on the host)
DATABASE_URL=sqlite:////app/data/hr.db
MEDIA_DIR=/app/media

# Your program spreadsheet. Keep it OUTSIDE this repo; it is read, never copied in.
# Local run: a full Windows path. In Docker Compose: the host path to mount (see compose.yaml).
PROGRAM_XLSX_PATH=C:/path/outside/the/repo/Workout_Program.xlsx

# Docker Compose only: the spreadsheet's path on the host, mounted read-only into the container.
PROGRAM_XLSX_HOST_PATH=C:/path/outside/the/repo/Workout_Program.xlsx
